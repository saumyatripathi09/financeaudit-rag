# Where uploads, the database and the vector index are stored
AUDIT_RAG_DATA_DIR=data

# Full path to tesseract.exe (not on PATH on Windows by default)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Local LLM served by Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Local embedding model (downloaded once, then cached)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Upload limit in megabytes
MAX_UPLOAD_MB=50

LOG_LEVEL=INFO

# Keep false so documents never go to a non-local LLM
ALLOW_REMOTE_LLM=false
